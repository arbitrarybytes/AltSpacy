<Window x:Class="AltSpacy.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AltSpacy"
        Title="AltSpacy Settings" Width="1120" Height="800" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen" ThemeMode="System" KeyDown="OnWindowKeyDown"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Brand.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:ShortcutIconConverter x:Key="IconOf" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="28,22,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="LogoImage" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" />
                </Image.Effect>
            </Image>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" />
                <TextBlock x:Name="VersionText" Style="{StaticResource Brand.Hint}" />
            </StackPanel>
            <TextBlock Grid.Column="2" VerticalAlignment="Bottom" Style="{StaticResource Brand.Hint}" MaxWidth="460" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=ConfigPathRun}">
                <Run Text="Saved to " /><Run x:Name="ConfigPathRun" />
            </TextBlock>
        </Grid>
        <Rectangle DockPanel.Dock="Top" Height="2" Margin="28,16,28,0" Fill="{StaticResource Brand.Line}" RadiusX="1" RadiusY="1" />

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Padding="28,14" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Padding="20,6" Margin="0,0,10,0" Click="OnCancel" />
                    <Button Content="Save" Style="{StaticResource Brand.PrimaryButton}" Click="OnSave" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="#FFE5484D" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Margin="28,18,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: general + try it -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
                <Border Style="{StaticResource Brand.Card}">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource Brand.CardTitle}" />
                        <TextBlock Text="Hotkey" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Button x:Name="HotkeyButton" Style="{StaticResource Brand.HotkeyButton}" Click="OnHotkeyClick"
                                PreviewKeyDown="OnHotkeyKeyDown" LostKeyboardFocus="OnHotkeyBlur"
                                AutomationProperties.Name="Hotkey">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="&#xE765;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Grid MinHeight="30">
                                    <ItemsControl x:Name="HotkeyKeys" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Brand.Keycap}">
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Brand.KeycapText}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="HotkeyPrompt" Text="Press the new shortcut…" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
                                </Grid>
                            </DockPanel>
                        </Button>
                        <TextBlock x:Name="HotkeyHint" Text="Click to change." Style="{StaticResource Brand.Hint}" Margin="0,6,0,14" />

                        <DockPanel Margin="0,0,0,18">
                            <CheckBox x:Name="StartWithWindowsSwitch" DockPanel.Dock="Right" Style="{StaticResource Brand.Switch}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Start with Windows" />
                            <StackPanel>
                                <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                                <TextBlock Text="Runs in the tray at sign-in, ready for the hotkey." Style="{StaticResource Brand.Hint}" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="Browser" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,10">
                            <CheckBox x:Name="DefaultBrowserSwitch" DockPanel.Dock="Right" Style="{StaticResource Brand.Switch}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Use default browser" Checked="OnDefaultBrowserChanged" Unchecked="OnDefaultBrowserChanged" />
                            <StackPanel>
                                <TextBlock Text="Use default browser" />
                                <TextBlock x:Name="DefaultBrowserName" Style="{StaticResource Brand.Hint}" />
                            </StackPanel>
                        </DockPanel>
                        <ListBox x:Name="BrowserList" Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource Brand.Tile}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:BrowserInfo}">
                                    <StackPanel>
                                        <Image Source="{Binding Icon}" Width="32" Height="32" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Name}" Margin="0,8,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Brand.Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Try it" Style="{StaticResource Brand.CardTitle}" />
                        <DockPanel>
                            <Button x:Name="OpenTestButton" DockPanel.Dock="Right" Content="Open" Margin="8,0,0,0" Padding="14,5" Click="OnOpenTest" />
                            <TextBox x:Name="TestBox" TextChanged="OnTestChanged" KeyDown="OnTestKeyDown" />
                        </DockPanel>
                        <TextBlock x:Name="TestResult" Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                   TextWrapping="Wrap" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Brand.Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="How URLs are built" Style="{StaticResource Brand.CardTitle}" />
                        <TextBlock Style="{StaticResource Brand.Hint}">
                            <Run FontWeight="SemiBold" Text="{}{q}" /><Run Text="  what you type, without surrounding quotes" />
                            <LineBreak />
                            <Run FontWeight="SemiBold" Text="{}{raw}" /><Run Text="  what you type, exactly" />
                            <LineBreak />
                            <Run FontWeight="SemiBold" Text="Prefix" /><Run Text="  added to digits-only values (j 41 opens PROJ-41)" />
                            <LineBreak />
                            <Run FontWeight="SemiBold" Text="Icon" /><Run Text="  defaults to the site's favicon" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <!-- Right: shortcuts grouped by app -->
            <Border Grid.Column="2" Style="{StaticResource Brand.Card}" Padding="18,16,18,10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="+ Add" Padding="14,5" Margin="0,0,8,0" Click="OnAdd" />
                            <Button Content="Remove" Padding="14,5" Click="OnRemove" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Shortcuts" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Grouped by app. Type the key, a space, then the value." Style="{StaticResource Brand.Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="ShortcutGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                              HeadersVisibility="Column" SelectionMode="Extended" GridLinesVisibility="None" RowHeight="34"
                              IsSynchronizedWithCurrentItem="False"
                              Background="Transparent" BorderThickness="0"
                              CurrentCellChanged="OnGridChanged" CellEditEnding="OnCellEditEnding" RowEditEnding="OnRowEditEnding">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
                                            <ContentControl Content="{Binding Items, Converter={StaticResource IconOf}}" Width="24" Height="24" VerticalAlignment="Center"
                                                            ContentTemplate="{StaticResource Brand.Icon}" />
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="10,0,12,0" VerticalAlignment="Center" />
                                            <ItemsControl ItemsSource="{Binding Items}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Brand.Chip}">
                                                            <TextBlock Text="{Binding Key}" Style="{StaticResource Brand.ChipText}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding Converter={StaticResource IconOf}}" Width="20" Height="20"
                                                        ContentTemplate="{StaticResource Brand.Icon}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Key" Width="64" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Description" Width="170" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="URL template" Width="*" Binding="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Prefix" Width="70" Binding="{Binding PrefixIfNumeric, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Project" Width="70" Binding="{Binding DefaultProject, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Icon" Width="90" Binding="{Binding Icon, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
