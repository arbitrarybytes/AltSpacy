<Window x:Class="AltSpacy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AltSpacy"
        Title="AltSpacy" Width="820" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        Deactivated="OnDeactivated" SourceInitialized="OnSourceInitialized"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Palette: replaced at runtime by ApplyPalette() to follow the Windows light/dark setting. -->
        <SolidColorBrush x:Key="Bar.Tint" Color="#C81C1C22" />
        <SolidColorBrush x:Key="Bar.Text" Color="#FFF5F6F8" />
        <SolidColorBrush x:Key="Bar.SubText" Color="#FFA1A7B3" />
        <SolidColorBrush x:Key="Bar.Faint" Color="#FF7C8290" />
        <SolidColorBrush x:Key="Bar.Selected" Color="#1CFFFFFF" />
        <SolidColorBrush x:Key="Bar.Chip" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="Bar.ChipStroke" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="Bar.Divider" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="Bar.Badge" Color="#FFFFD08A" />
        <SolidColorBrush x:Key="Bar.Scroll" Color="#38FFFFFF" />
        <SolidColorBrush x:Key="Bar.ScrollHover" Color="#80FFFFFF" />

        <!-- Slim overlay scrollbar: no arrows or track; the pill widens on hover and turns brand-colored while dragging. -->
        <Style x:Key="Bar.PageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Bar.Thumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Pill" Width="4" CornerRadius="2" HorizontalAlignment="Right" Margin="0,2,2,2"
                                Background="{DynamicResource Bar.Scroll}" />
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                                <Setter TargetName="Pill" Property="Width" Value="8" />
                                <Setter TargetName="Pill" Property="CornerRadius" Value="4" />
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Bar.ScrollHover}" />
                            </DataTrigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Pill" Property="Width" Value="8" />
                                <Setter TargetName="Pill" Property="CornerRadius" Value="4" />
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Bar.AccentVertical}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Bar.ScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="12">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Bar.PageButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Bar.PageButton}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Bar.Thumb}" MinHeight="36" />
                            </Track.Thumb>
                        </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Bar.ScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter Margin="0,0,10,0" CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Style="{StaticResource Bar.ScrollBar}"
                                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="Bar.Accent" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFF6A3D" Offset="0" />
            <GradientStop Color="#FFE0399E" Offset="0.5" />
            <GradientStop Color="#FF8B5CF6" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Bar.AccentVertical" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFF6A3D" Offset="0" />
            <GradientStop Color="#FFC026D3" Offset="1" />
        </LinearGradientBrush>

        <local:UpperCaseConverter x:Key="Upper" />

        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bar.Chip}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Bar.ChipStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,0,5,1" />
            <Setter Property="Margin" Value="12,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeycapText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Bar.SubText}" />
        </Style>
        <SolidColorBrush x:Key="Bar.IconPlate" Color="#F0FFFFFF" />

        <!-- Footer command chip: colored glyph + ":command". -->
        <Style x:Key="Bar.FooterCommand" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Padding="7,3,8,4" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bar.Chip}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bar.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Bar.FooterGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,6,0" />
        </Style>
        <Style x:Key="Bar.FooterLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Bar.SubText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Bar.Faint}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- BorderBrush is the slowly rotating brand gradient, set in code and shared with GlowRing. -->
    <Border x:Name="Shell" Background="{DynamicResource Bar.Tint}" BorderThickness="1.5" CornerRadius="8" RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ShellScale" />
                <TranslateTransform x:Name="ShellShift" />
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Soft inner glow along the gradient border (DWM clips anything outside the window). -->
            <Border x:Name="GlowRing" Grid.RowSpan="5" CornerRadius="8" BorderThickness="4" Margin="-2" Opacity="0.55" IsHitTestVisible="False">
                <Border.Effect>
                    <BlurEffect Radius="14" />
                </Border.Effect>
            </Border>

            <!-- Search row -->
            <Grid Margin="18,16,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="42" Height="42" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="IconScale" />
                    </Grid.RenderTransform>
                    <Border x:Name="LogoPlate" CornerRadius="10" Padding="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsPlate}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Bar.IconPlate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Image x:Name="LogoImage" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" />
                            </Image.Effect>
                        </Image>
                    </Border>
                </Grid>
                <Grid Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Placeholder" Text="Search apps, settings, websites…" IsHitTestVisible="False"
                               FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24" Foreground="{DynamicResource Bar.Faint}"
                               VerticalAlignment="Center" Margin="2,0,0,1" />
                    <TextBox x:Name="Input" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24"
                             Foreground="{DynamicResource Bar.Text}" CaretBrush="{DynamicResource Bar.Text}"
                             SelectionBrush="#FFE0399E" Background="Transparent" BorderThickness="0" Padding="0"
                             VerticalContentAlignment="Center" TextChanged="OnInputChanged" PreviewKeyDown="OnInputKeyDown">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
                <Border x:Name="AppChip" Grid.Column="2" CornerRadius="11" Padding="10,3,11,4" VerticalAlignment="Center"
                        Background="{DynamicResource Bar.Chip}" BorderBrush="{DynamicResource Bar.ChipStroke}" BorderThickness="1"
                        Visibility="Collapsed">
                    <TextBlock x:Name="AppChipText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Bar.SubText}" />
                </Border>
            </Grid>

            <!-- Signature gradient line -->
            <Rectangle Grid.Row="1" Height="2" Fill="{StaticResource Bar.Accent}" RenderTransformOrigin="0.5,0.5" Opacity="0.9">
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="AccentScale" />
                </Rectangle.RenderTransform>
            </Rectangle>

            <!-- Where Enter goes -->
            <Border x:Name="PreviewChip" Grid.Row="2" Margin="18,12,18,2" Padding="10,6" CornerRadius="6"
                    Background="{DynamicResource Bar.Chip}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource Bar.SubText}" VerticalAlignment="Center" Margin="0,1,8,0" />
                    <TextBlock x:Name="Preview" FontFamily="Cascadia Mono, Consolas" FontSize="12" MaxWidth="680"
                               Foreground="{DynamicResource Bar.SubText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Results -->
            <ListBox x:Name="Suggestions" Grid.Row="3" Margin="10,6,10,8" MaxHeight="392" Focusable="False"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                     SelectionChanged="OnSuggestionChanged">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Style="{StaticResource Bar.ScrollViewer}" CanContentScroll="False" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name, Converter={StaticResource Upper}}" Margin="12,10,0,4"
                                           FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Bar.Faint}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnItemClicked" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding Detail}" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid Margin="0,1">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" />
                                        <Rectangle x:Name="Bar" Width="3" RadiusX="1.5" RadiusY="1.5" Margin="2,10" HorizontalAlignment="Left"
                                                   Fill="{StaticResource Bar.AccentVertical}" Visibility="Collapsed" />
                                        <ContentPresenter Margin="12,0,10,0" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bar.Chip}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Bar.Selected}" />
                                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:LauncherItem}">
                        <Grid Height="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="IconPlate" Width="32" Height="32" CornerRadius="8" Padding="2" Background="Transparent" VerticalAlignment="Center">
                                <Image Source="{Binding Icon.Image}" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Bar.Text}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,1,0,0"
                                           Foreground="{DynamicResource Bar.SubText}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="BadgeChip" CornerRadius="5" Padding="7,1,7,2" BorderThickness="1"
                                        Background="{DynamicResource Bar.Chip}" BorderBrush="{DynamicResource Bar.ChipStroke}">
                                    <TextBlock Text="{Binding Badge}" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Bar.Badge}" />
                                </Border>
                                <Border x:Name="EnterCap" Style="{StaticResource Keycap}" Margin="8,0,0,0" Visibility="Collapsed">
                                    <TextBlock Text="↵" Style="{StaticResource KeycapText}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Badge}" Value="">
                                <Setter TargetName="BadgeChip" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Icon.NeedsPlate}" Value="True">
                                <Setter TargetName="IconPlate" Property="Background" Value="{DynamicResource Bar.IconPlate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="EnterCap" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer -->
            <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Bar.Divider}" Padding="16,9,14,10">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Image x:Name="FooterLogo" Width="16" Height="16" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" ToolTip="{x:Static local:AppInfo.DisplayName}" />
                        <Button Style="{StaticResource Bar.FooterCommand}" Tag="settings" Click="OnFooterCommand" ToolTip="AltSpacy settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource Bar.FooterGlyph}" Foreground="#FFFF6A3D" />
                                <TextBlock Text=":settings" Style="{StaticResource Bar.FooterLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Bar.FooterCommand}" Tag="about" Click="OnFooterCommand" ToolTip="About AltSpacy">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" Style="{StaticResource Bar.FooterGlyph}" Foreground="#FF8B5CF6" />
                                <TextBlock Text=":about" Style="{StaticResource Bar.FooterLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Bar.FooterCommand}" Tag="reload" Click="OnFooterCommand" ToolTip="Reload shortcuts.json">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Bar.FooterGlyph}" Foreground="#FF14B8A6" />
                                <TextBlock Text=":reload" Style="{StaticResource Bar.FooterLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Bar.FooterCommand}" Tag="exit" Click="OnFooterCommand" ToolTip="Exit AltSpacy">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7E8;" Style="{StaticResource Bar.FooterGlyph}" Foreground="#FFF43F5E" />
                                <TextBlock Text=":exit" Style="{StaticResource Bar.FooterLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="↵" Style="{StaticResource KeycapText}" /></Border>
                        <TextBlock Text="Open" Style="{StaticResource HintText}" />
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Tab" Style="{StaticResource KeycapText}" /></Border>
                        <TextBlock Text="Complete" Style="{StaticResource HintText}" />
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl ⇧ ↵" Style="{StaticResource KeycapText}" /></Border>
                        <TextBlock Text="Admin" Style="{StaticResource HintText}" />
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Esc" Style="{StaticResource KeycapText}" /></Border>
                        <TextBlock Text="Close" Style="{StaticResource HintText}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
