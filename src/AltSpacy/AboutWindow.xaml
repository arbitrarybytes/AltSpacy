<Window x:Class="AltSpacy.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About AltSpacy" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ThemeMode="System" KeyDown="OnWindowKeyDown" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Brand.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel>
        <!-- Hero -->
        <Grid Height="184" ClipToBounds="True" Background="{StaticResource Brand.Gradient}">
            <Ellipse Width="320" Height="320" Fill="White" Opacity="0.08" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-90,0" />
            <Ellipse Width="200" Height="200" Fill="White" Opacity="0.06" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-70,0,0,-110" />
            <Ellipse Width="90" Height="90" Stroke="White" StrokeThickness="2" Opacity="0.18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,60,-30" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="34,0,0,0">
                <Border CornerRadius="26" Background="#33FFFFFF" Padding="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" />
                    </Border.Effect>
                    <Image x:Name="LogoImage" Width="92" Height="92" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="AltSpacy" FontSize="38" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI Variable Display, Segoe UI" />
                    <Border CornerRadius="10" Background="#33FFFFFF" Padding="10,2,10,3" HorizontalAlignment="Left" Margin="2,4,0,0">
                        <TextBlock x:Name="VersionText" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                    <TextBlock Text="Type it. Go there." Foreground="#E6FFFFFF" FontSize="14" Margin="2,10,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Margin="28,22,28,24">
            <TextBlock TextWrapping="Wrap" FontSize="14"
                       Text="Open any site, like GitHub, Google, Jira or GitLab, by typing a key and a value, find people in Teams with t name, or run any Windows tool, console or setting by name, just like Win+R." />
            <TextBlock x:Name="HotkeyText" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource Brand.Hint}" />

            <TextBlock Text="Keys" Style="{StaticResource Brand.CardTitle}" Margin="0,20,0,8" />
            <WrapPanel>
                <ItemsControl x:Name="HotkeyKeys" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Brand.Keycap}">
                                <TextBlock Text="{Binding}" Style="{StaticResource Brand.KeycapText}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="open" VerticalAlignment="Center" Margin="2,0,18,0" Style="{StaticResource Brand.Hint}" />
                <Border Style="{StaticResource Brand.Keycap}"><TextBlock Text="Tab" Style="{StaticResource Brand.KeycapText}" /></Border>
                <TextBlock Text="complete" VerticalAlignment="Center" Margin="2,0,18,0" Style="{StaticResource Brand.Hint}" />
                <Border Style="{StaticResource Brand.Keycap}"><TextBlock Text="Ctrl" Style="{StaticResource Brand.KeycapText}" /></Border>
                <Border Style="{StaticResource Brand.Keycap}"><TextBlock Text="Shift" Style="{StaticResource Brand.KeycapText}" /></Border>
                <Border Style="{StaticResource Brand.Keycap}"><TextBlock Text="↵" Style="{StaticResource Brand.KeycapText}" /></Border>
                <TextBlock Text="run as admin" VerticalAlignment="Center" Margin="2,0,0,0" Style="{StaticResource Brand.Hint}" />
            </WrapPanel>

            <TextBlock Text="What's new" Style="{StaticResource Brand.CardTitle}" Margin="0,22,0,8" />
            <Border Style="{StaticResource Brand.Card}" Padding="16,12">
                <ItemsControl x:Name="Notes">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <Border Style="{StaticResource Brand.Chip}" VerticalAlignment="Top" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Version}" Style="{StaticResource Brand.ChipText}" />
                                </Border>
                                <TextBlock TextWrapping="Wrap" Text="{Binding Notes}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <DockPanel Margin="0,22,0,0">
                <Button DockPanel.Dock="Right" Content="OK" IsDefault="True" Style="{StaticResource Brand.PrimaryButton}" Padding="30,7" Click="OnOk" />
                <!-- Copyright, license and no-warranty notice ("Appropriate Legal Notices", GPL v3 section 5d). -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="CopyrightText" Style="{StaticResource Brand.Hint}" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Brand.Hint}">
                        <Run Text="Free software under the" />
                        <Hyperlink x:Name="LicenseLink" RequestNavigate="OnNavigate"><Run x:Name="LicenseRun" /></Hyperlink><Run Text=", with no warranty." />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </StackPanel>
</Window>
