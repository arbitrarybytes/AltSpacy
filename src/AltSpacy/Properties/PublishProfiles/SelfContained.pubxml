<Project>
  <!-- One AltSpacy.exe with the .NET runtime inside: runs on any 64-bit Windows 10/11, nothing to install.
       dotnet publish src/AltSpacy -p:PublishProfile=SelfContained   (build.ps1 does this for releases) -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WPF's DirectWriteForwarder.dll is C++/CLI and can't load from inside the bundle; extract everything on first run (cached). -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\dist\self-contained\</PublishDir>
  </PropertyGroup>
</Project>
