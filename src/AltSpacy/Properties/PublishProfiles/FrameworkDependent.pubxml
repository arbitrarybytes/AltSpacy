<Project>
  <!-- Small AltSpacy.exe that uses the installed .NET Desktop Runtime (10 or newer).
       Without one, Windows shows a dialog linking to the runtime download.
       dotnet publish src/AltSpacy -p:PublishProfile=FrameworkDependent   (build.ps1 does this for releases) -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Single file so the exe can be renamed and moved on its own (a plain apphost needs AltSpacy.dll beside it). -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Prefer .NET 10; if only a newer major is installed (11, 12...), run on that instead of refusing to start. -->
    <RollForward>Major</RollForward>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\dist\framework-dependent\</PublishDir>
  </PropertyGroup>
</Project>
